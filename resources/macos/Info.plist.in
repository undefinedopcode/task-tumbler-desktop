<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>task-tumbler</string>
    <key>CFBundleIdentifier</key>
    <string>org.kde.tasktumbler</string>
    <key>CFBundleName</key>
    <string>Task Tumbler</string>
    <key>CFBundleDisplayName</key>
    <string>Task Tumbler</string>
    <key>CFBundleIconFile</key>
    <string>task-tumbler.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${PROJECT_VERSION}</string>
    <key>CFBundleVersion</key>
    <string>${PROJECT_VERSION}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Task Tumbler shows your calendar events on its schedule and plans tasks around them. It only reads them; it never changes your calendars.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>MIT licence</string>
</dict>
</plist>
